# Absolute path to your Obsidian vault.
OBSIDIAN_VAULT_PATH=/absolute/path/to/your/Obsidian/Vault

# Local Ollama server.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=llama3.2
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_TEMPERATURE=0.2

# Local persistence.
FAISS_INDEX_PATH=./data/faiss_obsidian
MEMORY_DB_PATH=./data/checkpoints.sqlite

# Retrieval and web safety limits.
RETRIEVAL_K=6
WEB_MAX_RESULTS=5
WEB_PAGE_CHAR_LIMIT=7000
WEB_REQUEST_TIMEOUT=15

# Set to true to watch the vault for changes.
WATCH_OBSIDIAN=true

# Optional long-term memory layer.
# Keep false for the base local agent; set true after Memanto on-prem is configured.
MEMANTO_ENABLED=false
MEMANTO_AGENT_ID=local-obsidian-researcher
MOORCHEH_API_KEY=
